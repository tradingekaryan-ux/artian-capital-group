# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Artian Capital Group"

# ── Solana ───────────────────────────────────────────────────────────
# devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Helius free tier (opsional tapi disarankan); kosongkan = RPC publik
HELIUS_API_KEY=
NEXT_PUBLIC_RPC_URL=

# ── Treasury (penerima fee USDC & sumber refund — TIDAK membayar gas;
#    gas semua transaksi dibayar wallet user dari saldo SOL-nya) ───────
# secret key base58 (solana-keygen new --no-bip39-passphrase)
TREASURY_SECRET_KEY=

# ── Master key enkripsi private key user (32 bytes base64) ───────────
# generate: openssl rand -base64 32
WALLET_MASTER_KEY=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron / worker ────────────────────────────────────────────────────
CRON_SECRET=

# ── Market data & swap ───────────────────────────────────────────────
JUPITER_API_KEY=
JUPITER_API_BASE=https://lite-api.jup.ag
DEXSCREENER_API_BASE=https://api.dexscreener.com

# ── Email OTP (opsional; tanpa ini kode OTP hanya muncul di log dev) ─
RESEND_API_KEY=

# ── Cluster-specific mint ────────────────────────────────────────────
# default otomatis: mainnet EPjFWdd5... / devnet 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT=

# ── Mode demo (wallet devnet per user — latihan tanpa nilai nyata) ────
# RPC khusus wallet demo (opsional; default = RPC publik devnet)
NEXT_PUBLIC_DEMO_RPC_URL=
# Override USDC mint devnet (default: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU)
USDC_MINT_DEMO=
# Treasury untuk pembayaran fee devnet. Boleh keypair yang sama dengan
# TREASURY_SECRET_KEY (cluster-agnostic). Tidak butuh airdrop SOL —
# treasury tidak membayar gas (user-paid gas).
TREASURY_SECRET_KEY_DEMO=

# ── Analytics (opsional; kosongkan = tracking mati) ──────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
