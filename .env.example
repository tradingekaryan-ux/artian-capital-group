# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Artian Capital Group"

# ── Solana ───────────────────────────────────────────────────────────
# devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Helius free tier (opsional tapi disarankan); kosongkan = RPC publik
HELIUS_API_KEY=
NEXT_PUBLIC_RPC_URL=

# ── Treasury (hot wallet platform: pembayar semua gas on-chain) ──────
# secret key base58 (solana-keygen new --no-bip39-passphrase)
TREASURY_SECRET_KEY=

# ── Master key enkripsi private key user (32 bytes base64) ───────────
# generate: openssl rand -base64 32
WALLET_MASTER_KEY=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron / worker ────────────────────────────────────────────────────
CRON_SECRET=

# ── Market data & swap ───────────────────────────────────────────────
JUPITER_API_KEY=
JUPITER_API_BASE=https://lite-api.jup.ag
DEXSCREENER_API_BASE=https://api.dexscreener.com

# ── Email OTP (opsional; tanpa ini kode OTP hanya muncul di log dev) ─
RESEND_API_KEY=

# ── Cluster-specific mint ────────────────────────────────────────────
# default otomatis: mainnet EPjFWdd5... / devnet 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT=

# ── Analytics (opsional; kosongkan = tracking mati) ──────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
